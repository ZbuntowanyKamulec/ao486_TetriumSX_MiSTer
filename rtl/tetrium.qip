# Tetrium CPU (rtl/tetrium: subtree of github.com/ZbuntowanyKamulec/Tetrium) and its ao486 bridge
set_global_assignment -name SEARCH_PATH [file join $::quartus(qip_path) tetrium/rtl]
set_global_assignment -name SEARCH_PATH [file join $::quartus(qip_path) tetrium/rtl/gen]
set_global_assignment -name VERILOG_MACRO "ALTERA=1"
# $readmemh paths are relative to the project directory
set_global_assignment -name VERILOG_MACRO "UCODE_FILE=\"rtl/tetrium/rtl/gen/ucode_rom.hex\""
# RAM initial-value loops (predictor tables) exceed the default 5000 iterations
set_global_assignment -name VERILOG_CONSTANT_LOOP_LIMIT 1000000
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) tetrium/rtl/gen/tetrium_pkg.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) tetrium/rtl/tetrium_prims.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) tetrium/rtl/tetrium_fetch.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) tetrium/rtl/tetrium_decode.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) tetrium/rtl/tetrium_agu.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) tetrium/rtl/tetrium_mem.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) tetrium/rtl/tetrium_exec.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) tetrium/rtl/tetrium_wb.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) tetrium/rtl/tetrium_biu.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) tetrium/rtl/tetrium_mmu.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) tetrium/rtl/tetrium_core.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) tetrium/rtl/tetrium_top.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) tetrium_ao486.sv]

+/* i486 TLB as seen through TR6 / TR7 (8 sets x 4 ways, pseudo-LRU).
+   86Box translates without a TLB; this models the TLB test operations only: entries
+   written through TR6, flushed by a CR3 write, dropped by INVLPG.  It matches the i486
+   (and Tetrium) while paging is off. */
+static uint32_t tlbt_tag[8][4], tlbt_pa[8][4];
+static uint8_t  tlbt_at[8][4], tlbt_v[8], tlbt_lru[8];   /* at: D U W;  lru: B2 B1 B0 */
+static void
+tlbt_touch(int s, int w)
+{
+    uint8_t b = tlbt_lru[s];
+    b = (b & ~1) | !(w >> 1);
+    if (w < 2) b = (b & ~2) | (!(w & 1) << 1);
+    else       b = (b & ~4) | (!(w & 1) << 2);
+    tlbt_lru[s] = b;
+}
+static int
+tlbt_victim(int s)
+{
+    for (int i = 0; i < 4; i++)
+        if (!(tlbt_v[s] >> i & 1))
+            return i;
+    return (tlbt_lru[s] & 1) ? (2 | (tlbt_lru[s] >> 2 & 1)) : (tlbt_lru[s] >> 1 & 1);
+}
+void
+cpu_tlbt_flush(void)
+{
+    memset(tlbt_v, 0, sizeof(tlbt_v));
+}
+void
+cpu_tlbt_invlpg(uint32_t a)
+{
+    int s = (a >> 12) & 7;
+    for (int i = 0; i < 4; i++)
+        if (tlbt_tag[s][i] == (a >> 15))
+            tlbt_v[s] &= ~(1 << i);
+}
+static int
+tlbt_pm(uint32_t pr, int b)
+{
+    return ((pr & 2) && b) || ((pr & 1) && !b);
+}

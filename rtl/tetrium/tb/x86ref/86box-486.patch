 extern uint64_t mmutranslate_noabrt_2386(uint32_t addr, int rw);
+/* i486 debug registers: DR6.B bits of the current instruction's data breakpoints (set in
+   DR6 when it completes; a faulting instruction sets none and traps not); the linear
+   address of a REP string instruction continuing with its next iteration (its
+   instruction breakpoint is not checked again) */
+uint32_t dr6_b_pend;
+uint32_t cpu_rep_cont_lin = 0xffffffff;
+
+/* Tetrium lockstep: a trap or interrupt between two iterations of a REP
+   string instruction pushes RF = 1 (SDM 17.3.1.1). */
+void
+cpu_rep_rf(void)
+{
+    if ((msw & 1) && ((cs + cpu_state.pc) == cpu_rep_cont_lin))
+        cpu_state.eflags |= RF_FLAG;
+}
+
+/* i486: after an exception / interrupt delivery, the data breakpoints its accesses matched
+   (enabled: a trap) and the T bit of a task it switched to: #DB before the handler's
+   first instruction.  The #DB delivery's own accesses match nothing. */
+void
+cpu_debug_trap_after_delivery(void)
+{
+    if (cpu_state.abrt)
+        return;
+    if (cpu_debug_regs_486) {
+        dr[6] |= dr6_b_pend;
+        dr6_b_pend = 0;
+    }
+    /* (without the debug registers: the T bit only) */
+    if (trap & (cpu_debug_regs_486 ? 0xe : 0x2)) {
+        if (cpu_debug_regs_486) {
+            if (trap & 2)
+                dr[6] |= 0x8000;
+            dr[7] &= ~0x2000;
+        }
+        trap = 0;
+        oldcs           = CS;
+        cpu_state.oldpc = cpu_state.pc;
+        x86_int(1);
+        dr6_b_pend = 0;
+        trap &= ~0xe;
+    }
+}

 int cpu_386_check_instruction_fault(void);
+
+/* x86ref (Tetrium lockstep, a real 386 / 486): the real-mode interrupt frame (FLAGS, CS, IP)
+   is pushed with the SS limit check. A slot past the limit (a word at offset FFFF) raises
+   #SS; delivering that (and then #DF) pushes the same slots at the same SP again, so the
+   processor shuts down (386 PRM: PUSH / INT with SP = 1, PUSHA / PUSHAD with SP = 1, 3, 5).
+   The slots below the faulting one are written. Returns 0 if the frame was not pushed
+   (shutdown: the reference resets, as on a triple fault, or another abort is pending). */
+static inline int
+rm_push_frame(uint16_t f, uint16_t c, uint16_t ip)
+{
+    uint16_t v[3] = { f, c, ip };
+    for (int i = 0; i < 3; i++) {
+        uint32_t a = stack32 ? (ESP - 2 * (i + 1)) : ((SP - 2 * (i + 1)) & 0xffff);
+        if ((a < cpu_state.seg_ss.limit_low) || ((uint64_t) a + 1 > cpu_state.seg_ss.limit_high)) {
+            cpu_state.abrt = 0;
+            softresetx86();
+            cpu_set_edx();
+            return 0;
+        }
+        writememw(ss, a, v[i]);
+        if (cpu_state.abrt)
+            return 0;
+    }
+    if (stack32)
+        ESP -= 6;
+    else
+        SP -= 6;
+    return 1;
+}

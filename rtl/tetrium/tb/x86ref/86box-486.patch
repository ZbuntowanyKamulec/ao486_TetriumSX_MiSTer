+                    tlbt_at[s][w]  = (((val >> 10) & 1) << 2) | (((val >> 8) & 1) << 1) | ((val >> 6) & 1);
+                    tlbt_v[s] = (tlbt_v[s] & ~(1 << w)) | (((val >> 11) & 1) << w);
